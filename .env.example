# =============================================================
# Variáveis de ambiente da stack (docker-compose.yml / Portainer)
# Configure como variáveis de ambiente do stack no Portainer
# (Add stack → Environment variables) — não precisa subir o .env.
# =============================================================

# Domínio público do app
DOMAIN=app.redeapoiopolitico.com.br

# Senha do Postgres (redeapoio-postgres)
DB_PASSWORD=troque-esta-senha-por-uma-forte

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-longa-minimo-32-caracteres

# --- E-mail transacional (recuperação de senha) — conta Hostinger ---
# Mesmo padrão usado no gtw-platform/gtw-imobi.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=naoresponda@redeapoiopolitico.com.br
SMTP_PASS=senha-da-caixa-de-email
SMTP_FROM="RedeApoio <naoresponda@redeapoiopolitico.com.br>"

# --- Apenas para rodar a migração de dados uma única vez (bash migrate.sh) ---
# Adicione estas duas nas Environment Variables da stack no Portainer só na hora
# da migração. Depois de migrar com sucesso e rotacionar a service_role key no
# Supabase, remova as duas do Portainer e atualize a stack — elas não servem
# para mais nada depois disso.
SUPABASE_URL=https://bvpvsqzdvruachbgyvzq.supabase.co
SUPABASE_SERVICE_KEY=cole-aqui-a-service-role-key-do-supabase
