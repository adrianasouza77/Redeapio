# Copie este arquivo para ".env" e preencha os valores reais. NUNCA versione o .env.

# --- Postgres (usado pelo docker-compose) ---
POSTGRES_DB=redeapoio
POSTGRES_USER=redeapoio
POSTGRES_PASSWORD=troque-esta-senha-por-uma-forte

# --- Backend ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-string-aleatoria-longa
PUBLIC_URL=https://app.redeapoiopolitico.com.br

# --- Apenas para rodar a migração de dados uma única vez (scripts/migrate-from-supabase.js) ---
SUPABASE_URL=https://bvpvsqzdvruachbgyvzq.supabase.co
SUPABASE_SERVICE_KEY=cole-aqui-a-service-role-key-do-supabase
