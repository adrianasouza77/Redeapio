# =============================================================
# Variáveis de ambiente da stack (docker-compose.yml / Portainer)
# Configure como variáveis de ambiente do stack no Portainer
# (Add stack → Environment variables) — não precisa subir o .env.
# =============================================================

# Domínio público do app
DOMAIN=app.redeapoiopolitico.com.br

# Senha do Postgres (redeapoio-postgres)
DB_PASSWORD=troque-esta-senha-por-uma-forte

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-longa-minimo-32-caracteres

# --- Apenas para rodar a migração de dados uma única vez ---
# (backend/scripts/migrate-from-supabase.js — rodado manualmente via docker exec,
# não faz parte das variáveis do stack)
SUPABASE_URL=https://bvpvsqzdvruachbgyvzq.supabase.co
SUPABASE_SERVICE_KEY=cole-aqui-a-service-role-key-do-supabase
